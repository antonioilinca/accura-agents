# Copie ce fichier en .env et renseigne UNE clé selon le fournisseur choisi dans config.yaml.
# Le .env n'est jamais committé.

# --- Option GRATUITE par défaut : Groq (Llama 3.3 70B) ---
# Clé gratuite sur https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Autres options gratuites (décommente selon config.yaml) ---
# MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx     # https://console.mistral.ai/
# (Ollama local : aucune clé nécessaire)

# Note : sans clé payante ci-dessous, la finition IA des devis tourne déjà
# gratuitement sur Groq (la GROQ_API_KEY ci-dessus suffit). La clé payante ne fait
# que reprendre le dessus pour la qualité maximale.

# --- Option payante (qualité max), quand un client paie ---
# Agent Devis : si OPENAI_API_KEY est renseignée, la finition IA des devis s'active
# automatiquement en mode `llm.provider: auto` dans config/devis.yaml (priorité sur Groq).
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clé sur https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
